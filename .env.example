DATABASE_URL=postgresql+psycopg://coursewatch:coursewatch@localhost:5432/coursewatch
APP_ORIGIN=http://localhost:3000
ENVIRONMENT=development
# Generate a private value: uv run python -c 'import secrets; print(secrets.token_hex(32))'
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Course Watch <alerts@localhost>
# For deployment, set EMAIL_BACKEND=resend and use a verified sending domain.
RESEND_API_KEY=
POLL_INTERVAL_SECONDS=300
SPIRE_REQUEST_INTERVAL_SECONDS=3
