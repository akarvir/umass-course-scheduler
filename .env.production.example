APP_HOST=watch.example.com
APP_ORIGIN=https://watch.example.com
ENVIRONMENT=production
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Use a random hex password so it is safe inside a database URL.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
EMAIL_BACKEND=resend
EMAIL_FROM=Course Watch <alerts@your-verified-domain.com>
RESEND_API_KEY=replace-with-your-api-key
POLL_INTERVAL_SECONDS=300
SPIRE_REQUEST_INTERVAL_SECONDS=3
